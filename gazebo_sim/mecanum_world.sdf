<?xml version="1.0" ?>

<sdf version="1.10">
    <world name="mecanum_world">

        <physics name="physics" type="ignored">
            <max_step_size>0.001</max_step_size>
            <real_time_factor>1.0</real_time_factor>
        </physics>

        <plugin
            filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics">
        </plugin>

        <plugin
            filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands">
        </plugin>

        <plugin
            filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster">
        </plugin>

        <light type="directional" name="sun">
            <pose>0 0 10 0 0 0</pose>
            <cast_shadows>true</cast_shadows>

            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>

            <direction>-0.5 0.1 -0.9</direction>
        </light>

        <!-- ground plane -->
        <model name="ground_plane">
            <static>true</static>

            <link name="ground_link">

                <collision name="ground_collision">
                    <geometry>
                        <plane>
                            <normal>0 0 1</normal>
                            <size>100 100</size>
                        </plane>
                    </geometry>
                </collision>

                <visual name="ground_visual">
                    <geometry>
                        <plane>
                            <normal>0 0 1</normal>
                            <size>100 100</size>
                        </plane>
                    </geometry>

                    <material>
                        <ambient>0.7 0.7 0.7 1</ambient>
                        <diffuse>0.7 0.7 0.7 1</diffuse>
                    </material>
                </visual>

            </link>
        </model>

        <!-- mecanum robot -->
        <model name="mecanum_robot"
               xmlns:gz="http://gazebosim.org/schema">

            <!-- chassis center -->
            <link name="chassis">
                <pose>0 0 0.23 0 0 0</pose>

                <inertial>
                    <mass>8.0</mass>

                    <inertia>
                        <ixx>0.25</ixx>
                        <iyy>0.40</iyy>
                        <izz>0.55</izz>

                        <ixy>0</ixy>
                        <ixz>0</ixz>
                        <iyz>0</iyz>
                    </inertia>
                </inertial>

                <collision name="collision">
                    <geometry>
                        <box>
                            <size>0.70 0.50 0.15</size>
                        </box>
                    </geometry>
                </collision>

                <visual name="visual">
                    <geometry>
                        <box>
                            <size>0.70 0.50 0.15</size>
                        </box>
                    </geometry>

                    <material>
                        <ambient>0.2 0.4 0.8 1</ambient>
                        <diffuse>0.2 0.4 0.8 1</diffuse>
                    </material>
                </visual>
            </link>

            <!-- front left -->
            <link name="front_left_wheel">
                <pose>0.30 0.32 0.15 -1.5708 0 0</pose>

                <inertial>
                    <mass>1.0</mass>

                    <inertia>
                        <ixx>0.01</ixx>
                        <iyy>0.01</iyy>
                        <izz>0.01</izz>

                        <ixy>0</ixy>
                        <ixz>0</ixz>
                        <iyz>0</iyz>
                    </inertia>
                </inertial>

                <visual name="visual">
                    <geometry>
                        <cylinder>
                            <radius>0.15</radius>
                            <length>0.08</length>
                        </cylinder>
                    </geometry>

                    <material>
                        <ambient>0.1 0.1 0.1 1</ambient>
                        <diffuse>0.1 0.1 0.1 1</diffuse>
                    </material>
                </visual>

                <!-- friction direction of sphere collision emulates the mecanum rollers. -->
                <collision name="collision">
                    <geometry>
                        <sphere>
                            <radius>0.15</radius>
                        </sphere>
                    </geometry>

                    <surface>
                        <friction>
                            <ode>
                                <mu>1.0</mu>
                                <mu2>0.0</mu2>

                                <fdir1 gz:expressed_in="chassis">
                                    1 -1 0
                                </fdir1>
                            </ode>
                        </friction>
                    </surface>
                </collision>
            </link>

            <!-- front right -->
            <link name="front_right_wheel">
                <pose>0.30 -0.32 0.15 -1.5708 0 0</pose>

                <inertial>
                    <mass>1.0</mass>

                    <inertia>
                        <ixx>0.01</ixx>
                        <iyy>0.01</iyy>
                        <izz>0.01</izz>

                        <ixy>0</ixy>
                        <ixz>0</ixz>
                        <iyz>0</iyz>
                    </inertia>
                </inertial>

                <visual name="visual">
                    <geometry>
                        <cylinder>
                            <radius>0.15</radius>
                            <length>0.08</length>
                        </cylinder>
                    </geometry>

                    <material>
                        <ambient>0.1 0.1 0.1 1</ambient>
                        <diffuse>0.1 0.1 0.1 1</diffuse>
                    </material>
                </visual>

                <collision name="collision">
                    <geometry>
                        <sphere>
                            <radius>0.15</radius>
                        </sphere>
                    </geometry>

                    <surface>
                        <friction>
                            <ode>
                                <mu>1.0</mu>
                                <mu2>0.0</mu2>

                                <fdir1 gz:expressed_in="chassis">
                                    1 1 0
                                </fdir1>
                            </ode>
                        </friction>
                    </surface>
                </collision>
            </link>

            <!-- rear left -->
            <link name="rear_left_wheel">
                <pose>-0.30 0.32 0.15 -1.5708 0 0</pose>

                <inertial>
                    <mass>1.0</mass>

                    <inertia>
                        <ixx>0.01</ixx>
                        <iyy>0.01</iyy>
                        <izz>0.01</izz>

                        <ixy>0</ixy>
                        <ixz>0</ixz>
                        <iyz>0</iyz>
                    </inertia>
                </inertial>

                <visual name="visual">
                    <geometry>
                        <cylinder>
                            <radius>0.15</radius>
                            <length>0.08</length>
                        </cylinder>
                    </geometry>

                    <material>
                        <ambient>0.1 0.1 0.1 1</ambient>
                        <diffuse>0.1 0.1 0.1 1</diffuse>
                    </material>
                </visual>

                <collision name="collision">
                    <geometry>
                        <sphere>
                            <radius>0.15</radius>
                        </sphere>
                    </geometry>

                    <surface>
                        <friction>
                            <ode>
                                <mu>1.0</mu>
                                <mu2>0.0</mu2>

                                <fdir1 gz:expressed_in="chassis">
                                    1 1 0
                                </fdir1>
                            </ode>
                        </friction>
                    </surface>
                </collision>
            </link>

            <!-- rear right -->
            <link name="rear_right_wheel">
                <pose>-0.30 -0.32 0.15 -1.5708 0 0</pose>

                <inertial>
                    <mass>1.0</mass>

                    <inertia>
                        <ixx>0.01</ixx>
                        <iyy>0.01</iyy>
                        <izz>0.01</izz>

                        <ixy>0</ixy>
                        <ixz>0</ixz>
                        <iyz>0</iyz>
                    </inertia>
                </inertial>

                <visual name="visual">
                    <geometry>
                        <cylinder>
                            <radius>0.15</radius>
                            <length>0.08</length>
                        </cylinder>
                    </geometry>

                    <material>
                        <ambient>0.1 0.1 0.1 1</ambient>
                        <diffuse>0.1 0.1 0.1 1</diffuse>
                    </material>
                </visual>

                <collision name="collision">
                    <geometry>
                        <sphere>
                            <radius>0.15</radius>
                        </sphere>
                    </geometry>

                    <surface>
                        <friction>
                            <ode>
                                <mu>1.0</mu>
                                <mu2>0.0</mu2>

                                <fdir1 gz:expressed_in="chassis">
                                    1 -1 0
                                </fdir1>
                            </ode>
                        </friction>
                    </surface>
                </collision>
            </link>

            <!-- wheel joints -->
            <joint name="front_left_wheel_joint" type="revolute">
                <parent>chassis</parent>
                <child>front_left_wheel</child>

                <axis>
                    <xyz>0 0 1</xyz>
                </axis>
            </joint>

            <joint name="front_right_wheel_joint" type="revolute">
                <parent>chassis</parent>
                <child>front_right_wheel</child>

                <axis>
                    <xyz>0 0 1</xyz>
                </axis>
            </joint>

            <joint name="rear_left_wheel_joint" type="revolute">
                <parent>chassis</parent>
                <child>rear_left_wheel</child>

                <axis>
                    <xyz>0 0 1</xyz>
                </axis>
            </joint>

            <joint name="rear_right_wheel_joint" type="revolute">
                <parent>chassis</parent>
                <child>rear_right_wheel</child>

                <axis>
                    <xyz>0 0 1</xyz>
                </axis>
            </joint>

            <!-- mechanum controller -->
            <plugin
                filename="gz-sim-mecanum-drive-system"
                name="gz::sim::systems::MecanumDrive">

                <front_left_joint>
                    front_left_wheel_joint
                </front_left_joint>

                <front_right_joint>
                    front_right_wheel_joint
                </front_right_joint>

                <back_left_joint>
                    rear_left_wheel_joint
                </back_left_joint>

                <back_right_joint>
                    rear_right_wheel_joint
                </back_right_joint>

                <!-- front to rear wheel-center distance -->
                <wheelbase>0.60</wheelbase>

                <!-- left to right wheel-center distance -->
                <wheel_separation>0.64</wheel_separation>

                <wheel_radius>0.15</wheel_radius>

                <topic>/cmd_vel</topic>
                <odom_publish_frequency>50</odom_publish_frequency>

            </plugin>

        </model>

    </world>
</sdf>



<!-- terminal 1 - start gazebo: gz sim gazebo_sim/mecanum_world.sdf -->
<!-- terminal 2 - source /opt/ros/jazzy/setup.bash
ros2 run ros_gz_bridge parameter_bridge \
'/cmd_vel@geometry_msgs/msg/Twist]gz.msgs.Twist' \
'/model/mecanum_robot/odometry@nav_msgs/msg/Odometry[gz.msgs.Odometry' -->
<!-- terminal 3 - source /opt/ros/jazzy/setup.bash
python3 ~/gazebo_sim/gazebo_receiver.py -->
<!-- terminal 4: python python/controller_gui_gazebo.py -->